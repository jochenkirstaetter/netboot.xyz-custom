#!ipxe

set menu-timeout 5000

:menu
menu Custom features (GitHub: ${github_user})
item --gap Choose wisely:
item shell ${space}         Open iPXE shell
item reboot ${space}        Reboot the system
item reload ${space}        Reload Menu
item main_menu ${space}     Back to Main Menu
choose --timeout ${menu-timeout} --default shell selected || goto menu_exit
goto ${selected}

:shell
echo This is a dummy custom iPXE configuration.
echo Type 'exit' to return to the menu.
shell
goto menu

:reboot
reboot

:reload
chain https://raw.githubusercontent.com/${github_user}/netboot.xyz-custom/main/custom.ipxe

:main_menu
:menu_exit
exit 0
